{
  "id": null,
  "uid": "app-load",
  "title": "App - Charge et latence",
  "tags": [
    "app",
    "http",
    "spring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requêtes / s (toutes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taux d'erreurs 5xx (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latence p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Threads Tomcat (busy / current)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(tomcat_threads_busy)",
          "legendFormat": "busy",
          "refId": "A"
        },
        {
          "expr": "sum(tomcat_threads_current)",
          "legendFormat": "current",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connexions DB (Hikari)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active)",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(hikaricp_connections_idle)",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "pending",
          "refId": "C"
        }
      ]
    }
  ]
}
