{
  "id": null,
  "uid": "kafka-overview",
  "title": "Kafka - Vue d'ensemble",
  "tags": [
    "kafka",
    "exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Brokers",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "kafka_brokers",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer group lag (total)",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag)",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Topic partitions",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_topic_partitions)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    }
  ]
}
